<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<!--
  Утренняя сводка (scripts/morning-briefing.sh): ближайшие заседания + inbox,
  уведомление macOS и — при настроенном секрете — напоминание в Telegram
  (scripts/themis_bot.py --notify-hearings). Каждый день в 9:00.

  __THEMIS_HOME__ — не готовый путь: launchd не разворачивает ~ и переменные
  окружения в ProgramArguments и WorkingDirectory, поэтому путь обязан быть
  абсолютным — но абсолютным ДЛЯ ЭТОЙ машины, а не для машины автора.
  Подстановка — при установке (делает install.sh, можно и руками).

  Установка (один раз, из корня проекта):
    sed "s|__THEMIS_HOME__|$PWD|g" scripts/themis.morning-briefing.plist \
      > ~/Library/LaunchAgents/themis.morning-briefing.plist
    launchctl load ~/Library/LaunchAgents/themis.morning-briefing.plist

  Остановка:
    launchctl unload ~/Library/LaunchAgents/themis.morning-briefing.plist

  Статус:
    launchctl list | grep themis.morning-briefing

  Ручной прогон (без ожидания 9:00):
    bash scripts/morning-briefing.sh
-->

<plist version="1.0">
<dict>
    <key>Label</key>
    <string>themis.morning-briefing</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__THEMIS_HOME__/scripts/morning-briefing.sh</string>
    </array>

    <!-- каждый день в 9:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>__THEMIS_HOME__</string>

    <key>StandardOutPath</key>
    <string>__THEMIS_HOME__/audit.log</string>

    <key>StandardErrorPath</key>
    <string>__THEMIS_HOME__/audit.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
